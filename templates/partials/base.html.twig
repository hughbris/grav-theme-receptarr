{% set theme_config = attribute(config.themes, config.system.pages.theme) %}
{% set default_feature_filename = 'featured.jpg' %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}" class='{% if browser.getBrowser == 'msie' and browser.getVersion == 7 and browser.getVersion == 8 %}{% else %}v2{% endif %} {% if browser.getBrowser == 'msie' and browser.getVersion == 7 %}ie ie7 ltie8 ltie9{% endif %} {% if browser.getBrowser == 'msie' and browser.getVersion == 8 %}ie ie8 ltie9{% endif %}'>
<head>
  {% block head %}
  <meta charset="utf-8" />
  <title>{% block page_title %}{% if header.title %}{{ header.title|e('html') }} - {% endif %}{{ site.title|e('html') }}{% endblock %}</title>
  {% include 'partials/metadata.html.twig' %}
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">

  {% block links %}
    {% if theme_config.favicon_image %}
      {% set favicon = theme_config.favicon_image|first %}
      {% set favicon_address = "user://images/#{favicon['name']}" %}
      {% link icon "#{favicon_address}" with { type: favicon['type'] } %} {# favicon_path must be a quoted string expression here or Twig won't parse #}
    {% else %}
      {% link icon 'theme://images/favicon.png' with { type: 'image/png' } %}
    {% endif %}
  {% endblock %}

  {% block stylesheets %}
    {% style 'theme://css/slick.css' %}
    {% style 'theme://genericons/genericons.css' %}
    {% style 'theme://css/starter.css' %}
    {% style 'theme://css/style.css' %}
    {% style 'theme://css/colors.css' %}
    {% style 'theme://css/jetpack.css' %}
    {% style 'theme://css/lightbox.css' %}
    {% style 'theme://css/custom.css' %}
    {% if browser.getBrowser == 'msie' and browser.getVersion >= 7 and browser.getVersion <= 8 %}
      {% style 'theme://css/ie.css' %}
    {% endif %}
    {% style '//fonts.googleapis.com/css?family=Roboto%7CRoboto+Condensed%3A400%2C300%7CAlegreya%3A400%2C700&#038;subset&#038;ver=44d4db587900ff753163772c910c3b34' priority: 102 with { media: 'all', id: 'receptar-google-fonts-css' } %}
    {% style '//netdna.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.css' priority: 101 %}
    {% style '//fonts.googleapis.com/css?family=Roboto+Slab%3A400%2C700&ver=4.2.2' priority: 100 with { media: 'all', id: 'roboto-slab-css' } %}
  {% endblock %}

  {% block javascripts %}
    {% script 'jquery' priority: 101 %}
    {% script 'theme://js/slick.min.js' %}
    {% script 'theme://js/scripts-global.js' %}
    {% script 'theme://js/custom.js' %}
  {% endblock %}

  {% set has_feature_column = singular %} {# seems to be what 'singular' actually means #}
  {% if has_feature_column %}
    {% if page.header.feature.source and page.media[page.header.feature.source] %}
      {% set bg_image = page.media[page.header.feature.source] %}
    {% elseif page.media.images is not empty %}
      {% set bg_image = page.media.images|first %}
    {% elseif theme_config.fallback_image %}
      {% set bg_fallback = theme_config.fallback_image|first %}
      {% set bg_image = media["user://images/#{bg_fallback['name']}"] %}
    {% elseif site.global_featured_image and media["theme://images/#{site.global_featured_image}"] %} {# we'll actually support and deprecate this to make migrations smoother #}
      {{ debug('site.global_featured_image is deprecated since 2.3.0, please use fallback_image in receptarr.yaml') }}
      {% set bg_image = media["theme://images/#{site.global_featured_image}"] %}
    {% else %}
      {% set bg_image = media["theme://images/#{default_feature_filename}"] %}
    {% endif %}

    {% if bg_image %}
    {# {% set bg_url =
      page.header.feature.source
        ? page.media[page.header.feature.source].url
        : (
          page.media.images|first
            ? (page.media.images|first).url
            : "#{theme_url}/images/#{ theme_config.fallback_image}"
            )
      %} #}
      {% style with {'id': 'receptar-stylesheet-inline-css'} %}
        .entry-media{
          background-image: url('{{ bg_image.url|raw }}');
        }
      {% endstyle %}
    {% else %}
      {{ debug('partials/base template: No valid feature image found and no valid fallback or theme default!') }}
    {% endif %}
  {% endif %}

  {% block assets deferred %}
    {{ assets.link()|raw }}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
  {% endblock %}
{% endblock head %}
</head>

<body id="top" class="{% if template_body_classes %}{{ template_body_classes }}{% else %}fl-builder blog has-featured-posts is-not-singular{% endif %}{{ page.header.body_classes }}">
  <div id="page" class="hfeed site">
    <div class="site-inner">
      {% block header %}
        {% include 'partials/header.html.twig' %}
      {% endblock %}
      {% block slider %}{% endblock %}
      {% block body %}
      <div id="content" class="site-content">
        <div id="primary" class="content-area {% block primary_classes %}{% endblock %}">
          {% block content %}{% endblock %}
        </div>
      </div>
      {% endblock %}

      {% block footer %}
        {% include 'partials/footer.html.twig' %}
      {% endblock %}
  </div>
</div>

{{ assets.js('bottom')|raw }} 
</body>
</html>
